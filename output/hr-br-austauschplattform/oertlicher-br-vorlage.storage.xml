<ac:structured-macro ac:name="html" ac:schema-version="1">
<ac:plain-text-body><![CDATA[
<style>
.brx-dashboard{font-family:Arial,sans-serif;color:#1a1a3d;width:100%;max-width:none;margin:0 0 24px 0;box-sizing:border-box}
.brx-dashboard *{box-sizing:border-box}
.brx-hero{display:grid;grid-template-columns:1fr;gap:10px;padding:24px 28px;border-radius:18px;border:1px solid #d7e0f4;background:linear-gradient(135deg,#ffffff 0%,#f2f5fc 100%)}
.brx-kicker{color:#3b4fb0;font-size:13px;font-weight:700;letter-spacing:.04em;text-transform:uppercase}
.brx-hero h1{margin:4px 0 0 0;font-size:30px;color:#1a1a3d}
.brx-hero p{font-size:15px;line-height:1.55;color:#33395c;margin-top:8px;max-width:820px}
</style>
<div class="brx-dashboard">
  <div class="brx-hero">
    <div class="brx-kicker">Örtliche Ebene · VORLAGE — Phase 2</div>
    <h1>Örtlicher BR – {{STANDORT_NAME}}</h1>
    <p>Vorlage für die Anbindung eines einzelnen örtlichen Betriebsrats. Beim Rollout
    pro Standort kopieren, <strong>{{STANDORT_NAME}}</strong> durch den echten Standortnamen
    ersetzen, Seitentitel entsprechend anpassen (z. B. &quot;Örtlicher BR – Region
    Süd&quot;) und auf die passende Standort-Gruppe + HR beschränken.</p>
  </div>
</div>
]]></ac:plain-text-body>
</ac:structured-macro>

<ac:structured-macro ac:name="info" ac:schema-version="1">
  <ac:rich-text-body>
    <p>Diese Seite muss nach dem Anlegen auf die Gruppe des jeweiligen örtlichen BR (z. B.
    <strong>br-{{STANDORT_SLUG}}</strong>) und <strong>HR</strong> beschränkt werden.</p>
  </ac:rich-text-body>
</ac:structured-macro>

<h2>Formular A — Wahlergebnis</h2>
<p>Nach Wahlabschluss und nach der konstituierenden Sitzung ausfüllen. Angaben zur Wahl
selbst in diesem Formular; die gewählten Mitglieder werden einzeln weiter unten erfasst.</p>

<ac:structured-macro ac:name="confiform" ac:schema-version="1">
  <ac:parameter ac:name="formName">wahlInfo</ac:parameter>
  <ac:parameter ac:name="registrationFormTitle">Wahlergebnis erfassen</ac:parameter>
  <ac:rich-text-body>
    <p>
      <ac:structured-macro ac:name="confiform-field-definition" ac:schema-version="1">
        <ac:parameter ac:name="fieldName">artDerMitteilung</ac:parameter>
        <ac:parameter ac:name="fieldLabel">Art der Mitteilung</ac:parameter>
        <ac:parameter ac:name="values">false[erst=Erstmitteilung nach Neuwahl|aenderung=Änderungsmitteilung|]</ac:parameter>
        <ac:parameter ac:name="type">select</ac:parameter>
        <ac:parameter ac:name="required">true</ac:parameter>
      </ac:structured-macro>
    </p>
    <p>
      <ac:structured-macro ac:name="confiform-field-definition" ac:schema-version="1">
        <ac:parameter ac:name="fieldName">wahltag</ac:parameter>
        <ac:parameter ac:name="fieldLabel">Wahltag</ac:parameter>
        <ac:parameter ac:name="extras">dd.MM.yyyy</ac:parameter>
        <ac:parameter ac:name="type">date</ac:parameter>
      </ac:structured-macro>
    </p>
    <p>
      <ac:structured-macro ac:name="confiform-field-definition" ac:schema-version="1">
        <ac:parameter ac:name="fieldName">anzahlMitglieder</ac:parameter>
        <ac:parameter ac:name="fieldLabel">Anzahl gewählter Mitglieder</ac:parameter>
        <ac:parameter ac:name="type">text</ac:parameter>
      </ac:structured-macro>
    </p>
    <p>
      <ac:structured-macro ac:name="confiform-field-definition" ac:schema-version="1">
        <ac:parameter ac:name="fieldName">wahlbeteiligung</ac:parameter>
        <ac:parameter ac:name="fieldLabel">Wahlbeteiligung (%)</ac:parameter>
        <ac:parameter ac:name="type">text</ac:parameter>
      </ac:structured-macro>
    </p>
    <p>
      <ac:structured-macro ac:name="confiform-field-definition" ac:schema-version="1">
        <ac:parameter ac:name="fieldName">datumKonstituierendeSitzung</ac:parameter>
        <ac:parameter ac:name="fieldLabel">Datum konstituierende Sitzung</ac:parameter>
        <ac:parameter ac:name="extras">dd.MM.yyyy</ac:parameter>
        <ac:parameter ac:name="type">date</ac:parameter>
      </ac:structured-macro>
    </p>
    <p>
      <ac:structured-macro ac:name="confiform-field-definition" ac:schema-version="1">
        <ac:parameter ac:name="fieldName">anmerkungen</ac:parameter>
        <ac:parameter ac:name="fieldLabel">Anmerkungen</ac:parameter>
        <ac:parameter ac:name="type">textarea</ac:parameter>
      </ac:structured-macro>
    </p>
    <ac:structured-macro ac:name="confiform-entry-register" ac:schema-version="1">
      <ac:parameter ac:name="formName">wahlInfo</ac:parameter>
      <ac:parameter ac:name="registrationButtonLabel">Wahlergebnis erfassen</ac:parameter>
      <ac:rich-text-body><p><br /></p></ac:rich-text-body>
    </ac:structured-macro>
  </ac:rich-text-body>
</ac:structured-macro>

<ac:structured-macro ac:name="confiform-table" ac:schema-version="1">
  <ac:parameter ac:name="formName">wahlInfo</ac:parameter>
  <ac:parameter ac:name="messageToShowWhenEmpty">Noch kein Wahlergebnis erfasst.</ac:parameter>
  <ac:rich-text-body>
    <ac:structured-macro ac:name="confiform-entry-edit" ac:schema-version="1">
      <ac:parameter ac:name="editButtonLabel">Bearbeiten</ac:parameter>
      <ac:parameter ac:name="deleteButtonLabel">Löschen</ac:parameter>
      <ac:parameter ac:name="updateMessage">Eintrag gespeichert.</ac:parameter>
      <ac:rich-text-body><p><br /></p></ac:rich-text-body>
    </ac:structured-macro>
    <ac:structured-macro ac:name="confiform-field" ac:schema-version="1"><ac:parameter ac:name="overrideLabel">Art</ac:parameter><ac:parameter ac:name="fieldName">artDerMitteilung</ac:parameter></ac:structured-macro>
    <ac:structured-macro ac:name="confiform-field" ac:schema-version="1"><ac:parameter ac:name="overrideLabel">Wahltag</ac:parameter><ac:parameter ac:name="fieldName">wahltag</ac:parameter></ac:structured-macro>
    <ac:structured-macro ac:name="confiform-field" ac:schema-version="1"><ac:parameter ac:name="overrideLabel">Mitglieder</ac:parameter><ac:parameter ac:name="fieldName">anzahlMitglieder</ac:parameter></ac:structured-macro>
    <ac:structured-macro ac:name="confiform-field" ac:schema-version="1"><ac:parameter ac:name="overrideLabel">Beteiligung</ac:parameter><ac:parameter ac:name="fieldName">wahlbeteiligung</ac:parameter></ac:structured-macro>
    <ac:structured-macro ac:name="confiform-field" ac:schema-version="1"><ac:parameter ac:name="overrideLabel">Konst. Sitzung</ac:parameter><ac:parameter ac:name="fieldName">datumKonstituierendeSitzung</ac:parameter></ac:structured-macro>
  </ac:rich-text-body>
</ac:structured-macro>

<h3>Gewählte Mitglieder</h3>
<ac:structured-macro ac:name="confiform" ac:schema-version="1">
  <ac:parameter ac:name="formName">gewaehlteMitglieder</ac:parameter>
  <ac:parameter ac:name="registrationFormTitle">Mitglied eintragen</ac:parameter>
  <ac:rich-text-body>
    <p><ac:structured-macro ac:name="confiform-field-definition" ac:schema-version="1"><ac:parameter ac:name="fieldName">name</ac:parameter><ac:parameter ac:name="fieldLabel">Name, Vorname</ac:parameter><ac:parameter ac:name="type">user</ac:parameter><ac:parameter ac:name="required">true</ac:parameter></ac:structured-macro></p>
    <p><ac:structured-macro ac:name="confiform-field-definition" ac:schema-version="1"><ac:parameter ac:name="fieldName">abteilung</ac:parameter><ac:parameter ac:name="fieldLabel">Bereich / Abteilung</ac:parameter><ac:parameter ac:name="type">text</ac:parameter></ac:structured-macro></p>
    <p><ac:structured-macro ac:name="confiform-field-definition" ac:schema-version="1"><ac:parameter ac:name="fieldName">stimmen</ac:parameter><ac:parameter ac:name="fieldLabel">Stimmen</ac:parameter><ac:parameter ac:name="type">text</ac:parameter></ac:structured-macro></p>
    <p><ac:structured-macro ac:name="confiform-field-definition" ac:schema-version="1"><ac:parameter ac:name="fieldName">funktion</ac:parameter><ac:parameter ac:name="fieldLabel">Funktion</ac:parameter><ac:parameter ac:name="values">false[mitglied=Mitglied|vorsitz=Vorsitz|stellv1=Stellvertretung 1.|stellv2=Stellvertretung 2.|ersatz=Ersatzmitglied|]</ac:parameter><ac:parameter ac:name="type">select</ac:parameter></ac:structured-macro></p>
    <p><ac:structured-macro ac:name="confiform-field-definition" ac:schema-version="1"><ac:parameter ac:name="fieldName">bemerkung</ac:parameter><ac:parameter ac:name="fieldLabel">Bemerkung</ac:parameter><ac:parameter ac:name="type">text</ac:parameter></ac:structured-macro></p>
    <ac:structured-macro ac:name="confiform-entry-register" ac:schema-version="1">
      <ac:parameter ac:name="formName">gewaehlteMitglieder</ac:parameter>
      <ac:parameter ac:name="registrationButtonLabel">Mitglied eintragen</ac:parameter>
      <ac:rich-text-body><p><br /></p></ac:rich-text-body>
    </ac:structured-macro>
  </ac:rich-text-body>
</ac:structured-macro>

<ac:structured-macro ac:name="confiform-table" ac:schema-version="1">
  <ac:parameter ac:name="formName">gewaehlteMitglieder</ac:parameter>
  <ac:parameter ac:name="messageToShowWhenEmpty">Noch keine Mitglieder erfasst.</ac:parameter>
  <ac:rich-text-body>
    <ac:structured-macro ac:name="confiform-entry-edit" ac:schema-version="1">
      <ac:parameter ac:name="editButtonLabel">Bearbeiten</ac:parameter>
      <ac:parameter ac:name="deleteButtonLabel">Löschen</ac:parameter>
      <ac:parameter ac:name="updateMessage">Eintrag gespeichert.</ac:parameter>
      <ac:rich-text-body><p><br /></p></ac:rich-text-body>
    </ac:structured-macro>
    <ac:structured-macro ac:name="confiform-field" ac:schema-version="1"><ac:parameter ac:name="overrideLabel">Name</ac:parameter><ac:parameter ac:name="fieldName">name</ac:parameter></ac:structured-macro>
    <ac:structured-macro ac:name="confiform-field" ac:schema-version="1"><ac:parameter ac:name="overrideLabel">Abteilung</ac:parameter><ac:parameter ac:name="fieldName">abteilung</ac:parameter></ac:structured-macro>
    <ac:structured-macro ac:name="confiform-field" ac:schema-version="1"><ac:parameter ac:name="overrideLabel">Stimmen</ac:parameter><ac:parameter ac:name="fieldName">stimmen</ac:parameter></ac:structured-macro>
    <ac:structured-macro ac:name="confiform-field" ac:schema-version="1"><ac:parameter ac:name="overrideLabel">Funktion</ac:parameter><ac:parameter ac:name="fieldName">funktion</ac:parameter></ac:structured-macro>
    <ac:structured-macro ac:name="confiform-field" ac:schema-version="1"><ac:parameter ac:name="overrideLabel">Bemerkung</ac:parameter><ac:parameter ac:name="fieldName">bemerkung</ac:parameter></ac:structured-macro>
  </ac:rich-text-body>
</ac:structured-macro>

<p><br /></p>
<h2>Formular B — Freistellungen</h2>
<p>Nach jedem BR-Beschluss über die Freistellungsverteilung ausfüllen (§ 38
BetrVG).</p>

<ac:structured-macro ac:name="confiform" ac:schema-version="1">
  <ac:parameter ac:name="formName">freistellungInfo</ac:parameter>
  <ac:parameter ac:name="registrationFormTitle">Freistellungsbeschluss erfassen</ac:parameter>
  <ac:rich-text-body>
    <p><ac:structured-macro ac:name="confiform-field-definition" ac:schema-version="1"><ac:parameter ac:name="fieldName">artDerMitteilung</ac:parameter><ac:parameter ac:name="fieldLabel">Art der Mitteilung</ac:parameter><ac:parameter ac:name="values">false[erst=Erstmitteilung nach Neuwahl|aenderung=Änderungsmitteilung|]</ac:parameter><ac:parameter ac:name="type">select</ac:parameter><ac:parameter ac:name="required">true</ac:parameter></ac:structured-macro></p>
    <p><ac:structured-macro ac:name="confiform-field-definition" ac:schema-version="1"><ac:parameter ac:name="fieldName">datumBeschluss</ac:parameter><ac:parameter ac:name="fieldLabel">Datum des BR-Beschlusses</ac:parameter><ac:parameter ac:name="extras">dd.MM.yyyy</ac:parameter><ac:parameter ac:name="type">date</ac:parameter><ac:parameter ac:name="required">true</ac:parameter></ac:structured-macro></p>
    <p><ac:structured-macro ac:name="confiform-field-definition" ac:schema-version="1"><ac:parameter ac:name="fieldName">gesetzlicheAnzahl</ac:parameter><ac:parameter ac:name="fieldLabel">Gesetzlich vorgesehene Anzahl (§ 38)</ac:parameter><ac:parameter ac:name="type">text</ac:parameter></ac:structured-macro></p>
    <ac:structured-macro ac:name="confiform-entry-register" ac:schema-version="1">
      <ac:parameter ac:name="formName">freistellungInfo</ac:parameter>
      <ac:parameter ac:name="registrationButtonLabel">Beschluss erfassen</ac:parameter>
      <ac:rich-text-body><p><br /></p></ac:rich-text-body>
    </ac:structured-macro>
  </ac:rich-text-body>
</ac:structured-macro>

<ac:structured-macro ac:name="confiform-table" ac:schema-version="1">
  <ac:parameter ac:name="formName">freistellungInfo</ac:parameter>
  <ac:parameter ac:name="messageToShowWhenEmpty">Noch kein Beschluss erfasst.</ac:parameter>
  <ac:rich-text-body>
    <ac:structured-macro ac:name="confiform-entry-edit" ac:schema-version="1">
      <ac:parameter ac:name="editButtonLabel">Bearbeiten</ac:parameter>
      <ac:parameter ac:name="deleteButtonLabel">Löschen</ac:parameter>
      <ac:parameter ac:name="updateMessage">Eintrag gespeichert.</ac:parameter>
      <ac:rich-text-body><p><br /></p></ac:rich-text-body>
    </ac:structured-macro>
    <ac:structured-macro ac:name="confiform-field" ac:schema-version="1"><ac:parameter ac:name="overrideLabel">Art</ac:parameter><ac:parameter ac:name="fieldName">artDerMitteilung</ac:parameter></ac:structured-macro>
    <ac:structured-macro ac:name="confiform-field" ac:schema-version="1"><ac:parameter ac:name="overrideLabel">Datum Beschluss</ac:parameter><ac:parameter ac:name="fieldName">datumBeschluss</ac:parameter></ac:structured-macro>
    <ac:structured-macro ac:name="confiform-field" ac:schema-version="1"><ac:parameter ac:name="overrideLabel">Gesetzl. Anzahl</ac:parameter><ac:parameter ac:name="fieldName">gesetzlicheAnzahl</ac:parameter></ac:structured-macro>
  </ac:rich-text-body>
</ac:structured-macro>

<h3>Freigestellte Mitglieder</h3>
<ac:structured-macro ac:name="confiform" ac:schema-version="1">
  <ac:parameter ac:name="formName">freistellungen</ac:parameter>
  <ac:parameter ac:name="registrationFormTitle">Freistellung eintragen</ac:parameter>
  <ac:rich-text-body>
    <p><ac:structured-macro ac:name="confiform-field-definition" ac:schema-version="1"><ac:parameter ac:name="fieldName">name</ac:parameter><ac:parameter ac:name="fieldLabel">Name, Vorname</ac:parameter><ac:parameter ac:name="type">user</ac:parameter><ac:parameter ac:name="required">true</ac:parameter></ac:structured-macro></p>
    <p><ac:structured-macro ac:name="confiform-field-definition" ac:schema-version="1"><ac:parameter ac:name="fieldName">umfang</ac:parameter><ac:parameter ac:name="fieldLabel">Freistellungsumfang (%)</ac:parameter><ac:parameter ac:name="type">text</ac:parameter></ac:structured-macro></p>
    <p><ac:structured-macro ac:name="confiform-field-definition" ac:schema-version="1"><ac:parameter ac:name="fieldName">wirksamAb</ac:parameter><ac:parameter ac:name="fieldLabel">Wirksam ab</ac:parameter><ac:parameter ac:name="extras">dd.MM.yyyy</ac:parameter><ac:parameter ac:name="type">date</ac:parameter></ac:structured-macro></p>
    <p><ac:structured-macro ac:name="confiform-field-definition" ac:schema-version="1"><ac:parameter ac:name="fieldName">aenderung</ac:parameter><ac:parameter ac:name="fieldLabel">Änderung ggü. Vorperiode</ac:parameter><ac:parameter ac:name="type">text</ac:parameter></ac:structured-macro></p>
    <ac:structured-macro ac:name="confiform-entry-register" ac:schema-version="1">
      <ac:parameter ac:name="formName">freistellungen</ac:parameter>
      <ac:parameter ac:name="registrationButtonLabel">Freistellung eintragen</ac:parameter>
      <ac:rich-text-body><p><br /></p></ac:rich-text-body>
    </ac:structured-macro>
  </ac:rich-text-body>
</ac:structured-macro>

<ac:structured-macro ac:name="confiform-table" ac:schema-version="1">
  <ac:parameter ac:name="formName">freistellungen</ac:parameter>
  <ac:parameter ac:name="messageToShowWhenEmpty">Noch keine Freistellungen erfasst.</ac:parameter>
  <ac:rich-text-body>
    <ac:structured-macro ac:name="confiform-entry-edit" ac:schema-version="1">
      <ac:parameter ac:name="editButtonLabel">Bearbeiten</ac:parameter>
      <ac:parameter ac:name="deleteButtonLabel">Löschen</ac:parameter>
      <ac:parameter ac:name="updateMessage">Eintrag gespeichert.</ac:parameter>
      <ac:rich-text-body><p><br /></p></ac:rich-text-body>
    </ac:structured-macro>
    <ac:structured-macro ac:name="confiform-field" ac:schema-version="1"><ac:parameter ac:name="overrideLabel">Name</ac:parameter><ac:parameter ac:name="fieldName">name</ac:parameter></ac:structured-macro>
    <ac:structured-macro ac:name="confiform-field" ac:schema-version="1"><ac:parameter ac:name="overrideLabel">Umfang</ac:parameter><ac:parameter ac:name="fieldName">umfang</ac:parameter></ac:structured-macro>
    <ac:structured-macro ac:name="confiform-field" ac:schema-version="1"><ac:parameter ac:name="overrideLabel">Wirksam ab</ac:parameter><ac:parameter ac:name="fieldName">wirksamAb</ac:parameter></ac:structured-macro>
    <ac:structured-macro ac:name="confiform-field" ac:schema-version="1"><ac:parameter ac:name="overrideLabel">Änderung</ac:parameter><ac:parameter ac:name="fieldName">aenderung</ac:parameter></ac:structured-macro>
  </ac:rich-text-body>
</ac:structured-macro>
