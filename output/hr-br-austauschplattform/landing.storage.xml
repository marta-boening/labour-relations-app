.brx-card{background:#fff;border:1px solid #dde3f2;border-radius:12px;padding:16px;box-shadow:0 4px 12px rgba(30,40,90,.05)}
.brx-card .brx-label{font-size:12px;color:#6b7290;font-weight:600;text-transform:uppercase;letter-spacing:.03em}
.brx-card .brx-value{font-size:24px;font-weight:800;color:#1a1a3d;margin-top:4px}
.brx-card .brx-value.warn{color:#c0392b}
.brx-card .brx-small{font-size:12px;color:#8890ab;margin-top:2px}
.brx-box{background:#fff;border:1px solid #dde3f2;border-radius:14px;padding:18px;margin-bottom:16px}
.brx-box h3{margin:0 0 12px 0;font-size:18px;color:#1a1a3d}
.brx-table{width:100%;border-collapse:collapse;font-size:14px}
.brx-table th{text-align:left;background:#f4f6fb;color:#4a5170;padding:9px 10px;border-bottom:1px solid #e2e6f2;font-weight:700;font-size:12px;text-transform:uppercase}
.brx-table td{padding:9px 10px;border-bottom:1px solid #eef0f7;vertical-align:top}
.brx-pill{display:inline-block;padding:4px 9px;border-radius:7px;font-size:12px;font-weight:700}
.brx-pill.blue{background:#e7ecfb;color:#2a3fa0}
.brx-pill.green{background:#e6f5ea;color:#1f7a3d}
.brx-pill.orange{background:#fdf0e0;color:#a5620a}
.brx-pill.red{background:#fbe6e6;color:#a4231b}
.brx-pill.grey{background:#eef0f5;color:#5b6178}
.brx-nav{margin-top:14px;padding:10px 14px;background:#fff;border:1px solid #dde3f2;border-radius:12px;display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.brx-nav-title{font-size:13px;font-weight:700;color:#33395c}
.brx-nav a{text-decoration:none;padding:8px 12px;border-radius:8px;border:1px solid #dde3f2;font-size:13px;font-weight:700;color:#2a3fa0;background:#f6f8fd}
.brx-lower-2cards{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media only screen and (max-width:900px){.brx-cards,.brx-lower-2cards{grid-template-columns:1fr}}
</style>
<div class="brx-dashboard">
  <div class="brx-hero">
    <div class="brx-kicker">HR – Betriebsrats-Zusammenarbeit</div>
    <h1>HR-BR Austauschplattform</h1>
    <p>Zentrale Plattform für den Informationsaustausch zwischen HR und den Betriebsratsgremien.
    Jedes Gremium hat einen eigenen, geschützten Bereich — nur das jeweilige Gremium und HR
    sehen die dort hinterlegten Informationen. Diese Übersichtsseite selbst zeigt keine
    vertraulichen Inhalte, sondern nur die Struktur und Navigation.</p>
  </div>
</div>
]]></ac:plain-text-body>
</ac:structured-macro>

