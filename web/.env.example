# Kopiere diese Datei zu ".env" (wird von Vite automatisch geladen, nicht in Git).

# Backend (server/) — Router->RAG->Executor-Pipeline
VITE_API_BASE_URL=http://localhost:3001

# Supabase (anon/public Key — sicher fuers Frontend, RLS in supabase/migrations/0001_init.sql
# beschraenkt Zugriff auf eigene Daten). Ohne diese Variablen laeuft die App im lokalen
# Einzelnutzer-Modus ohne Login (Chat funktioniert weiterhin, Faelle/Risiko-Radar bleiben leer).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
