# Kopiere diese Datei zu ".env" und trage deine echten Keys ein.
# .env wird nie eingecheckt (siehe .gitignore).

# Anthropic (Claude) - Router (Haiku) + Executor (Sonnet)
ANTHROPIC_API_KEY=

# Perplexity - Web-Recherche-Tool der Executor-Agenten
PERPLEXITY_API_KEY=

# Voyage AI - Embeddings fuer RAG (Qdrant)
VOYAGE_API_KEY=

# Qdrant Cloud - Vektordatenbank fuer frühere Fälle (RAG)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=lr_cases

# Prompt-Katalog (GitHub Repo mit Metadata + Prompt-Dateien)
PROMPTS_BASE_URL=https://raw.githubusercontent.com/marta-boening/LR_Prompts/main/

# Supabase - Nutzer-/Falldatenbank (optional, aber Voraussetzung fuer Verlauf/Faelle,
# Risiko-Radar und Agenten-Kennzahlen im neuen Frontend). Ohne diese Variablen laeuft
# der Server weiter, nur die Case-Historie bleibt leer.
# Service-Role-Key (NICHT der anon/public Key!) - nur server-seitig, nie im Frontend verwenden.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Passwortschutz (Pflicht sobald die App nicht mehr nur auf localhost läuft)
APP_USERNAME=
APP_PASSWORD=

# Server
PORT=3001
